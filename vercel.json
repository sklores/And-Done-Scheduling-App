{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/", "dest": "/public/landing.html" },
    { "src": "/manager", "dest": "/public/index.html" },
    { "src": "/employee", "dest": "/public/employee.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
